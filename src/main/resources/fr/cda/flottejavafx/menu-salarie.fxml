<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="319.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.cda.flottejavafx.Controllers.SalarieController">
   <children>
      <Button mnemonicParsing="false" onAction="#onAjoutSalarie" text="Ajout salarié" />
      <Button mnemonicParsing="false" onAction="#onDepart" text="Enregistrement départ" />
      <Button mnemonicParsing="false" onAction="#onRetour" text="Enregistrement retour" />
      <Button mnemonicParsing="false" onAction="#onEnDeplacement" text="Véhicule en déplacement" />
      <TextField fx:id="formMatricule" maxWidth="150.0" promptText="Matricule salarié" />
      <Button mnemonicParsing="false" onAction="#onHistorique" text="Historique salarié" />
      <Button mnemonicParsing="false" text="Retour" />
   </children>
</VBox>
